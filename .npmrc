shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
node-linker=isolated

# Allow electron + esbuild to run their postinstall (download binaries, prebuild native modules)
public-hoist-pattern[]=*electron*
# Rollup's optional platform-specific binaries live under @rollup/rollup-<os>-<arch>-<libc>
# and are loaded via runtime require() from inside the rollup package. pnpm's
# isolated linker hides those from rollup's resolver, breaking electron-vite dev
# on every fresh install with MODULE_NOT_FOUND. Hoisting the family fixes it.
# Ref: https://github.com/npm/cli/issues/4828
public-hoist-pattern[]=@rollup/*
allow-build-deps[]=electron
allow-build-deps[]=esbuild
